# Puerto del API
PORT=4000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=tickets
DB_PASSWORD=cambia-esta-contrasena
DB_NAME=sistema_tickets

# JWT: usa un valor largo y aleatorio, por ejemplo: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Orígenes permitidos por CORS (separados por comas)
CORS_ORIGINS=http://localhost:3000

# URL del frontend (para el enlace de recuperación de contraseña)
FRONTEND_BASE_URL=http://localhost:3000

# SMTP opcional. Si no se configura, el enlace de recuperación se imprime en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sistema de Tickets <no-reply@tickets.local>"
